{
  "$schema":"https://openapi.vercel.sh/vercel.json",
  "git":{"deploymentEnabled":true},
  "cleanUrls": false,
  "trailingSlash": false,
  "routes": [
    {
      "src": "^/$",
      "dest": "/api/app",
      "headers": {
        "Cache-Control": "no-store, max-age=0, must-revalidate",
        "CDN-Cache-Control": "no-store"
      }
    },
    { "handle": "filesystem" }
  ]
}
